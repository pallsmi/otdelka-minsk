{%- macro pic(name, sizes, alt, cls='', loading='lazy', priority=false) -%}
{%- set m = imgs[name] -%}
{%- set mid = m.widths[1] if m.widths|length > 1 else m.widths[0] -%}
<img{% if cls %} class="{{ cls }}"{% endif %} src="{{ root }}assets/img/{{ name }}-{{ mid }}.webp"
{%- if m.widths|length > 1 %} srcset="{% for w in m.widths %}{{ root }}assets/img/{{ name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}"{% endif %}
 width="{{ m.w }}" height="{{ m.h }}" alt="{{ alt }}" loading="{{ loading }}" decoding="{{ 'sync' if priority else 'async' }}"{% if priority %} fetchpriority="high"{% endif %}>
{%- endmacro -%}

{%- macro icon(name) -%}
{%- set paths = {
  'phone': '<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  'play': '<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/>',
  'chat': '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  'form': '<path d="M6 3h12v18H6zM9 8h6M9 12h6M9 16h4"/>',
  'close': '<path d="M6 6l12 12M18 6L6 18"/>',
  'left': '<path d="M15 5l-7 7 7 7"/>',
  'right': '<path d="M9 5l7 7-7 7"/>',
  'plane': '<path d="M21 4 3 11l6 2 2 6 3-4 5 4zM9 13 21 4"/>',
  'bubble': '<path d="M5 3h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6l-4 4v-4H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>',
  'round': '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 9.5c.5 2.5 2.5 4.5 5 5l1.2-1.2"/>'
} -%}
<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name] | safe }}</svg>
{%- endmacro -%}
