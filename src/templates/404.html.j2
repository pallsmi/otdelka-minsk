<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ru.nf_title }} | {{ brand_ru }}</title>
<meta name="robots" content="noindex">
<style>
  :root { color-scheme: light; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #30373B; color: #F3F5F4;
         font: 17px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; padding: 24px; box-sizing: border-box; }
  main { max-width: 34rem; }
  h1 { font-size: 1.75rem; line-height: 1.2; margin: 0 0 .5rem; }
  p { margin: 0 0 1.25rem; color: #B8C2C6; }
  a { display: inline-block; background: #A8E22B; color: #1F2427; font-weight: 600; padding: .8rem 1.2rem;
      border-radius: 8px; text-decoration: none; margin-right: .5rem; margin-bottom: .5rem; }
  a.alt { background: transparent; color: #F3F5F4; box-shadow: inset 0 0 0 2px #F3F5F4; }
  hr { border: 0; border-top: 1px solid #4A5358; margin: 2rem 0; }
</style>
</head>
<body>
<main>
  <h1>{{ ru.nf_title }}</h1>
  <p>{{ ru.nf_text }}</p>
  <a href="./" data-home>{{ ru.nf_link }}</a>
  <hr>
  <h1 lang="be">{{ be.nf_title }}</h1>
  <p lang="be">{{ be.nf_text }}</p>
  <a class="alt" href="./be/" data-home-be lang="be">{{ be.nf_link }}</a>
</main>
<script>
  // GitHub Pages отдаёт 404.html для любого пути внутри проекта — считаем корень сайта.
  (function () {
    var base = {{ base_path_json | safe }};
    if (!base) {
      var seg = location.pathname.split('/').filter(Boolean);
      base = location.hostname.endsWith('github.io') && seg.length ? '/' + seg[0] + '/' : '/';
    }
    document.querySelector('[data-home]').href = base;
    document.querySelector('[data-home-be]').href = base + 'be/';
  })();
</script>
</body>
</html>
